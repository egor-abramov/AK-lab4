read len !
len @ array d

: append_el
    read
    d @ i cells + !
    i @ 1 + !
;

0 i !
loop
    len @ i @ - 1 - >0 append_el
endloop

0 i !
: swap_el
    dj
    dj di @ !
    di !
;

loop
    i @ j !
    di d @ i cells + !
    loop
        dj d @ j cells + !
        di @ dj @ - >0 swap_el
        len @ j @ - 1 -
    endloop
    len @ i @ - 1 -
endloop


: print_el
    d @ i cells + .
    i @ 1 + !
;

0 i !
loop
    len @ i @ - 1 - >0 print_el
endloop
